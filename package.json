{
  "name": "macworx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cloudflare": "node scripts/cloudflare-build.mjs && npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spec": "node scripts/check-spec-coverage.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check:changelog": "node scripts/changelog-section.mjs --check",
    "check:all": "node scripts/check-all.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "5.20261012.1-beta",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.1"
  }
}
