// Cloudflare Workers config: the built app as static assets, plus the /api/* Worker (ARCHITECTURE.md).
// Workers Builds runs `npx wrangler deploy` for main and `npx wrangler preview` for other branches.
// Security headers come from public/_headers, which the build copies into dist.
{
  "name": "macworx",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any unknown path serves the app (index.html).
    "not_found_handling": "single-page-application",
    // /api and /api/* reach the Worker first; everything else is a static file.
    "run_worker_first": ["/api", "/api/*"],
  },
  // Cloudflare Access for the parent routes (worker/access.ts). Not secrets: Access shows both in its
  // sign-in link. Kept out of the "previews" block on purpose, so previews never serve parent routes.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "misty-butterfly-5638.cloudflareaccess.com",
    "ACCESS_AUD": "a5ceb91781123283e917a7c2aa1d0b8670bf874af456649bb0c408406fa4ab5d",
  },
  // At most 10 pairing tries a minute from one address (SPEC §6.9, worker/pair.ts).
  "ratelimits": [{ "name": "PAIR_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Production data: her Macaronis, streak and results. Workers Builds deploys main here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macworx",
      "database_id": "4567271a-d1b3-46a4-900f-e4d8b3afaf5f",
      "migrations_dir": "migrations",
    },
  ],
  // PR preview URLs (`wrangler preview`). Bindings don't carry over, and previews must never
  // touch production data, so they get their own database.
  "previews": {
    // Marks a preview for preview pairing (SPEC §6.9). Not a secret. The code itself is the Preview base-config
    // secret PREVIEW_PAIR_CODE. The Access vars stay out of this block, so previews never serve parent routes.
    "vars": { "PREVIEW": "1" },
    // Bindings don't carry into previews; their own namespace keeps their counters apart from production.
    "ratelimits": [
      { "name": "PAIR_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "macworx-preview",
        "database_id": "0c51256e-8800-42b6-a547-0bc6338aaa99",
        "migrations_dir": "migrations",
      },
    ],
  },
}
